# =============================================================================
# ION Environment Configuration Template
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.template .env
#
# All ION_* variables are read by the ION container via env_file in
# docker-compose.yml. Variables prefixed with ION_DB_ or ION_CPUS etc.
# are used by docker-compose.yml itself for resource limits.
# =============================================================================

# ── Server ────────────────────────────────────────────────────────────────
ION_HOST=0.0.0.0
ION_PORT=8000
ION_ADMIN_PASSWORD=admin2025
ION_DATA_DIR=/data

# ── Database (used by docker-compose for the postgres container) ──────────
ION_DB_PASSWORD=ion2025
# ION_DB_CPUS=4
# ION_DB_MEMORY=4G

# ── ION container resources ───────────────────────────────────────────────
# ION_CPUS=6
# ION_MEMORY=6G
ION_WORKERS=4

# ── TLS / Certificates ───────────────────────────────────────────────────
# Internal CA bundle for verifying outbound connections to ES, Kibana,
# Keycloak, TIDE, Arkime, OpenCTI, etc. Mount the cert via compose volume.
# ION_CA_BUNDLE=/etc/ssl/certs/custom-ca.pem
# Serve ION itself over HTTPS (cert + key in PEM format):
# ION_SSL_CERT=/path/to/server.crt
# ION_SSL_KEY=/path/to/server.key

# ── Integrations and application settings ────────────────────────────────
# Elasticsearch, Kibana, OpenCTI, GitLab, TIDE, Arkime, Ollama, OIDC, the base
# URL and the cookie and debug switches are managed in the ION settings UI and
# stored in $ION_DATA_DIR/.ion/config.json. They are deliberately not listed
# here: an environment variable outranks the settings UI, so putting one back in
# .env makes that field read-only in the UI ("set by environment").
# The two secrets that must stay here are ION_ADMIN_PASSWORD and ION_DB_PASSWORD.

# ── Other environment-only tuning ──────────────────────────────────────────────────────────────────────────
# Case-sync loop cadence in seconds (default 15, floor 5)
# ION_KIBANA_SYNC_INTERVAL_SECONDS=15
# ION_ES_ALERT_INDEX=.alerts-security.alerts-*,alerts-*

# ── OIDC / Keycloak SSO ──────────────────────────────────────────────────
# Role mapping: Keycloak realm role → ION role (JSON)
# ION_OIDC_ROLE_MAPPING={"soc-analyst":"analyst","soc-engineer":"engineering","soc-lead":"lead","admin":"admin"}

# ── TIDE (Threat Informed Detection Engineering) ──────────────────────────
# TIDE 4.x multi-tenant: set if your API key has access to multiple tenants
# ION_TIDE_CLIENT_ID=

# ── Arkime (PCAP analysis) ────────────────────────────────────────────────
# Auth: HTTP Basic only (front with nginx + Basic if you need SSO)
# Viewer URL reachable from ANALYST BROWSERS (deep links); defaults to ION_ARKIME_URL
# ION_ARKIME_PUBLIC_URL=
# Known-bad JA4 TLS fingerprints for the RTMON detector: ja4=label,ja4=label
# ION_ARKIME_RTMON_JA4_BLOCKLIST=
# Tag case sessions ion-<case-number> in the viewer (needs write-enabled user)
# ION_ARKIME_TAG_WRITEBACK=false

# ── WISE intel feed (ION IOCs → Arkime capture-time tagging) ──────────────
# Setting the token enables GET /api/wise/ion-iocs (404 while unset).
# wise.ini snippet lives in src/ion/web/wise_api.py's module docstring.
# ION_WISE_TOKEN=
# ION_WISE_MAX_IOCS=10000

# ── DFIR-IRIS (incident response escalation) ──────────────────────────────
# ION_DFIR_IRIS_ENABLED=false
# ION_DFIR_IRIS_URL=https://iris.guardedglass.internal
# ION_DFIR_IRIS_API_KEY=changeme
# ION_DFIR_IRIS_VERIFY_SSL=false

# ── GitLab (issue tracking) ──────────────────────────────────────────────

# ── AbuseIPDB ─────────────────────────────────────────────────────────────
# ION_ABUSEIPDB_ENABLED=false
# ION_ABUSEIPDB_API_KEY=changeme

# ── Network Mapper (CMDB from Elasticsearch) ─────────────────────────────
# ION_NETMAP_INTERVAL_S=120
# ION_NETMAP_LOOKBACK_MIN=10
# ION_NETMAP_INDEX=logs-*

# --- Required: ION refuses to start without these ---
ION_VERSION=0.99.8
ION_LOG_LEVEL=INFO
