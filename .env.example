# =============================================================================
# ION Environment Configuration
# Intelligent Operating Network
# =============================================================================
# Copy this file to .env and customize for your deployment
# =============================================================================

# -----------------------------------------------------------------------------
# Image Version
# -----------------------------------------------------------------------------
# ION_VERSION pins the image tag and is set in the required block below. Do not
# add a second one here: compose takes the LAST definition in the file, so a
# pin written above it is read, ignored, and never reported.

# -----------------------------------------------------------------------------
# Server Configuration
# -----------------------------------------------------------------------------
ION_HOST=0.0.0.0
ION_PORT=8000

# Data directory inside container (usually leave as default)
ION_DATA_DIR=/data

# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------
# Initial admin password (only used on first run when database is created)
# IMPORTANT: Change this before first deployment!
ION_ADMIN_PASSWORD=changeme

# -----------------------------------------------------------------------------
# TLS / Certificates
# -----------------------------------------------------------------------------
# CA bundle for verifying outbound connections to services with internal CA certs
# Point this at your CA certificate file (.pem or .crt)
#ION_CA_BUNDLE=/path/to/ca-bundle.crt

# Serve ION over HTTPS directly (no reverse proxy needed)
# Both cert and key must be PEM format
#ION_SSL_CERT=/path/to/server.crt
#ION_SSL_KEY=/path/to/server.key

# -----------------------------------------------------------------------------
# Integrations and application settings
# -----------------------------------------------------------------------------
# Elasticsearch, Kibana, OpenCTI, GitLab, TIDE, Arkime, Ollama, OIDC, the base
# URL and the cookie and debug switches are managed in the ION settings UI and
# stored in $ION_DATA_DIR/.ion/config.json. They are deliberately not listed
# here: an environment variable outranks the settings UI, so putting one back in
# .env makes that field read-only in the UI ("set by environment").
# The two secrets that must stay here are ION_ADMIN_PASSWORD and ION_DB_PASSWORD.

# Store LLM reasoning text in DB (investigations.reasoning_text +
# bob_eval_run_samples.reasoning_text). Increases PII footprint — the
# reasoning chain may include hostnames, usernames, and IPs from alert
# payloads. No automatic purge: operators must define a retention policy.
# Default: false (reasoning stored only in memory, not persisted).
# ION_BOB_STORE_REASONING=false

# -----------------------------------------------------------------------------
# TIDE Background Sync (Optional)
# -----------------------------------------------------------------------------
# Interval between TIDE data-sync runs, in seconds (default: 300 = 5 minutes).
# v0.22.0: renamed from ION_TIDE_SYNC_INTERVAL (old name accepted with a
# deprecation warning for one release cycle).
# ION_TIDE_SYNC_INTERVAL_S=300

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
ION_LOG_LEVEL=INFO

# Output format: JSON (true) or plain text (false)
# ION_LOG_JSON=true

# Use ECS (Elastic Common Schema) format — recommended when shipping to ES
# ION_LOG_ECS=true

# Write logs to a file (rotating, 50MB x 5 backups)
# ION_LOG_FILE=/data/logs/ion.log

# Ship logs directly to Elasticsearch (uses the same ES credentials above)
# ION_ES_LOG_URL=http://your-es-host:9200
# ION_ES_LOG_INDEX=ion-logs

# Send logs to a remote syslog server (UDP or TCP)
# ION_SYSLOG_URL=udp://syslog-host:514
# ION_SYSLOG_URL=tcp://syslog-host:514
# ION_SYSLOG_FACILITY=local0

# Service metadata (embedded in ECS log records)
# ION_SERVICE_NAME=ion
# ION_ENVIRONMENT=production

# --- Required: ION refuses to start without these ---
ION_VERSION=0.99.11
ION_WORKERS=2
ION_DB_PASSWORD=change-me-before-first-start
